{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visor de capturas",
  "version": "0.1.0",
  "identifier": "app.visorcapturas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Visor de capturas",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#0f1218"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://*.steamgriddb.com https://*.steamstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Spanish", "English"] }
    }
  }
}
